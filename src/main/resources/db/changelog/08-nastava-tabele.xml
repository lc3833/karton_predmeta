<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="kreiranje-nastava-tabela" author="lazar">

        <createTable tableName="teorijska_nastava">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="opis" type="TEXT"/>
            <column name="fond_casova" type="INT"/>
            <column name="nedeljni_plan_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_teorija_plan" references="nedeljni_plan(id)"/>
            </column>
        </createTable>

        <createTable tableName="prakticna_nastava">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="opis" type="TEXT"/>
            <column name="fond_casova" type="INT"/>
            <column name="tip_prakse" type="VARCHAR(50)"/> <column name="nedeljni_plan_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_praksa_plan" references="nedeljni_plan(id)"/>
            </column>
        </createTable>

    </changeSet>

</databaseChangeLog>